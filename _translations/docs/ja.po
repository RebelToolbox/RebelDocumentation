msgstr "別の空白行に隣接する場合。"

#: tutorials/scripting/c_sharp/c_sharp_style_guide.rst:140
msgid "Using spaces"
msgstr "スペースの使用"

#: tutorials/scripting/c_sharp/c_sharp_style_guide.rst:142
msgid "Insert a space:"
msgstr "スペースを挿入する:"

#: tutorials/scripting/c_sharp/c_sharp_style_guide.rst:144
