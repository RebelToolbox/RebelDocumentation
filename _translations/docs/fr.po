msgstr "Message"

#: getting_started/first_2d_game/06.heads_up_display.rst:78
msgid "*Layout* : \"HCenter Wide\""
msgstr "*Layout* / *Disposition sur l'écran* : \"HCenter Wide\""

#: getting_started/first_2d_game/06.heads_up_display.rst:79
