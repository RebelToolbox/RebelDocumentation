#, fuzzy
msgid "How can I support Rebel Engine development or contribute?"
msgstr "如何支持或参与 Godot 的发展？"

#: about/faq.rst:499
#, fuzzy
msgid "See :doc:`/contributing/ways_to_contribute`."
msgstr "请参阅 :ref:`doc_ways_to_contribute`。"

