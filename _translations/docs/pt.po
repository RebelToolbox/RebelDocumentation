#: tutorials/networking/high_level_multiplayer.rst:154
msgid "RPC"
msgstr "RPC"

#: tutorials/networking/high_level_multiplayer.rst:156
msgid ""
"To communicate between peers, the easiest way is to use RPCs (remote "
"procedure calls). This is implemented as a set of functions in :ref:`Node "
"<class_Node>`:"
msgstr ""

#: tutorials/networking/high_level_multiplayer.rst:159
msgid "``rpc(\"function_name\", <optional_args>)``"
msgstr ""

#: tutorials/networking/high_level_multiplayer.rst:160
msgid "``rpc_id(<peer_id>,\"function_name\", <optional_args>)``"
msgstr ""

#: tutorials/networking/high_level_multiplayer.rst:161
msgid "``rpc_unreliable(\"function_name\", <optional_args>)``"
